# Domínio do painel (aponte o DNS tipo A para o IP da VPS antes de subir)
DOMAIN=licencas.seudominio.com

# Primeiro administrador (criado só na primeira vez)
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=troque-esta-senha

# Gere com: openssl rand -hex 32
JWT_SECRET=

# Minutos sem contato para a instalação aparecer como "offline"
ONLINE_MINUTES=15
